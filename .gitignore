# --
# gitignore biodcase tiny ml

# ignore directory
ignore/
output/
# local virtualenvs (large, regenerable)
.venv-perch/
.venv/
# reference papers (external PDFs, not source)
papers/
# root-anchored so it ignores repo-root data/ ONLY, not experiments/data/ (pipeline code)
/data/
submission/reports
submission/your_generated_code/src
submission/example_submission_packages
submission/rank_submissions/eval_results.csv
submission/rank_submissions/results_task3_entries.yaml

# virtual env
.venv

# python specific
__pycache__

# other
#biodcase_tiny/embedded/firmware/main/feature_config_generated.h
biodcase_tiny/feature_extraction/FeatureConfig.py
biodcase_tiny/feature_extraction/FilterbankConfig.py

# for MacOS
.DS_Store

# secrets / local environment - NEVER commit real keys (e.g. XENO_CANTO_API_KEY).
# the committed template is .env.example; real values live in .env (ignored).
.env
.env.*
!.env.example

# perch raw embeddings (large, regenerable via experiments/perch/export_embeddings.py)
experiments/perch/embeddings/**/Train.npz
experiments/perch/embeddings/**/Validation.npz

# smoke-test run records (transient)
experiments/runs/*smoke*
experiments/timm/embeddings/
